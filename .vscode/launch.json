            "args": ["${workspaceFolder}/application/tests/res/above-clouds-mountains-peak-sunrise-moon-winter-cold-scenic-3440x1440-4569.jpg"],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "PainterBot: Build Release"
        }
    ]
}
